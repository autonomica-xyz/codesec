+            assert second["messages"][3]["role"] == "tool"
+            # Reasoning usage counted only where supplied.
+            assert result.raw_result_message["usage"]["reasoning_tokens"] == 4
+            assert result.raw_result_message["usage"]["reasoning_reported"] is True

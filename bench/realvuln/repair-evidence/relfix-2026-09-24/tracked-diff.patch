+                "run_id": "run",
+                "target": {"repo_path": str(tmp_path / "repo")},
+                "summary": {"total": 0, "by_severity": {}},
+                "findings": [
+                    {
+                        "finding_id": "f_reach",
+                        "title": "relocated finding",
+                        "severity": "critical",
+                        "vuln_class": "made_up_class",
+                        "file": "elsewhere.py",
+                        "line_start": 999,
+                        "line_end": 1000,
+                        "description": "A completely rewritten description of the issue.",
+                        "evidence": "fabricated evidence",
